# Anchor configuration — copied to /etc/anchor/anchor.env by setup_server.sh.
# ONE file holds every secret. Keep a copy in your password manager.

# --- Required ---------------------------------------------------------------
# Phone <-> server <-> GUI shared bearer token (setup_server.sh generates one).
ANCHOR_API_TOKEN=

# Claude agent brain backend.
#   claude_cli (default) — uses the local `claude` CLI with your subscription
#                          login; no API key needed. Install the CLI and run
#                          `claude` once as the anchor service user to log in:
#                          sudo -u anchor HOME=/var/lib/anchor claude
#   api                  — Anthropic API; requires ANTHROPIC_API_KEY below.
#ANCHOR_LLM_BACKEND=claude_cli
#ANCHOR_CLAUDE_CLI_BIN=claude
#ANCHOR_CLAUDE_CLI_TIMEOUT=600
#ANTHROPIC_API_KEY=

# Push notifications: pick a long random topic name (it is the only secret
# protecting your pushes on public ntfy.sh; or self-host ntfy and set a token).
ANCHOR_NTFY_TOPIC=
#ANCHOR_NTFY_URL=https://ntfy.sh
#ANCHOR_NTFY_TOKEN=

# Nightly encrypted backups: an age public key (private key stays OFF-BOX).
# Generate once anywhere:  age-keygen -o keys.txt   → put the public line here.
ANCHOR_BACKUP_AGE_RECIPIENT=

# --- Google (Calendar + People) ---------------------------------------------
# See deploy/setup_server.sh step 6 for the one-time OAuth bootstrap.
#ANCHOR_GOOGLE_CALENDAR_ID=primary

# --- Phase 3 ------------------------------------------------------------------
# Local semantic search over the vault (on-box ONNX embeddings, no cloud).
#ANCHOR_EMBED=1
#ANCHOR_EMBED_MODEL=BAAI/bge-small-en-v1.5

# Gmail ingestion (opt-in; READ-ONLY, label-filtered). Set up a Gmail filter
# that applies the label below to confirmation emails, set this to 1, then
# re-run: /opt/anchor/venv/bin/python -m anchor_server.google_auth
# (the token needs the gmail.readonly scope added).
#ANCHOR_GMAIL_ENABLED=0
#ANCHOR_GMAIL_LABEL=Anchor
#ANCHOR_GMAIL_POLL_SECONDS=900

# --- Tuning (defaults are sane) ---------------------------------------------
#ANCHOR_TIMEZONE=America/Detroit
#ANCHOR_AGENT_MODEL=claude-sonnet-4-6
#ANCHOR_WHISPER_MODEL=small          # tiny|base|small|medium|large-v3
#ANCHOR_API_HOST=127.0.0.1
#ANCHOR_API_PORT=8300
#ANCHOR_DATA_DIR=/var/lib/anchor

# Smoke-testing without Google/ntfy/Anthropic configured:
#ANCHOR_DRY_RUN=1
