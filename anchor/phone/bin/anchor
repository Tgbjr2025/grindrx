#!/data/data/com.termux/files/usr/bin/bash
# Anchor phone CLI — thin capture/sync client. No business logic here.
# Commands: rec | stop | photo | note | fix | ask | backfill | sweep | status
set -u

CONF="$HOME/.anchor/config"
[ -f "$CONF" ] && . "$CONF"
: "${ANCHOR_SERVER:?Run setup_termux.sh first (missing $CONF)}"
: "${ANCHOR_TOKEN:?Missing ANCHOR_TOKEN in $CONF}"

STATE_DIR="$HOME/.anchor"
REC_PID_FILE="$STATE_DIR/rec.pid"
REC_FILE_FILE="$STATE_DIR/rec.file"
mkdir -p "$STATE_DIR/captures"

api() { # api <method> <path> [curl args...]
    local method="$1" path="$2"; shift 2
    curl -sS -m 120 -X "$method" -H "Authorization: Bearer $ANCHOR_TOKEN" \
        "$ANCHOR_SERVER$path" "$@"
}

upload_file() { # upload_file <path> <kind> [batch_id] [backfill]
    local f="$1" kind="$2" batch="${3:-}" backfill="${4:-false}"
    local sha; sha=$(sha256sum "$f" | cut -d' ' -f1)
    local stamp; stamp=$(date -r "$f" +%Y-%m-%dT%H:%M:%S%:z 2>/dev/null || date +%Y-%m-%dT%H:%M:%S%:z)
    api POST /v1/ingest \
        -F "file=@$f" -F "kind=$kind" -F "sha256=$sha" \
        -F "source_path=$f" -F "captured_at=$stamp" \
        ${batch:+-F "batch_id=$batch"} -F "backfill=$backfill"
}

notify_user() { command -v termux-notification >/dev/null && \
    termux-notification --title "Anchor" --content "$1" || echo "$1"; }

case "${1:-help}" in
rec)
    if [ -f "$REC_PID_FILE" ]; then echo "Already recording. 'anchor stop' first."; exit 1; fi
    f="$STATE_DIR/captures/rec_$(date +%y%m%d_%H%M%S).m4a"
    termux-microphone-record -f "$f" -l 0 -e aac >/dev/null
    echo "$f" > "$REC_FILE_FILE"; touch "$REC_PID_FILE"
    notify_user "Recording... 'anchor stop' when done."
    ;;
stop)
    [ -f "$REC_FILE_FILE" ] || { echo "Not recording."; exit 1; }
    termux-microphone-record -q >/dev/null
    f=$(cat "$REC_FILE_FILE"); rm -f "$REC_PID_FILE" "$REC_FILE_FILE"
    sleep 1
    resp=$(upload_file "$f" note) \
        && notify_user "Voice note uploaded — Anchor is processing it." \
        || notify_user "Upload FAILED — kept locally; the 15-min sweep will retry."
    ;;
photo)
    f="$STATE_DIR/captures/photo_$(date +%y%m%d_%H%M%S).jpg"
    termux-camera-photo -c 0 "$f"
    resp=$(upload_file "$f" photo) \
        && notify_user "Photo captured and uploaded." \
        || notify_user "Photo upload FAILED — sweep will retry."
    ;;
note)
    shift; text="${*:-}"
    [ -z "$text" ] && { printf "note> "; read -r text; }
    api POST /v1/ingest/text -H 'Content-Type: application/json' \
        -d "$(jq -n --arg t "$text" '{text: $t, kind: "note"}')" >/dev/null \
        && notify_user "Note saved." || notify_user "Note upload FAILED."
    ;;
fix)
    shift; text="${*:?usage: anchor fix <what to correct>}"
    api POST /v1/fix -H 'Content-Type: application/json' \
        -d "$(jq -n --arg t "$text" '{instruction: $t}')" | jq -r '.result'
    ;;
ask)
    shift; q="${*:?usage: anchor ask <question>}"
    api POST /v1/ask -H 'Content-Type: application/json' \
        -d "$(jq -n --arg q "$q" '{question: $q}')" | jq -r '.answer'
    ;;
backfill)
    batch="bf-$(date +%y%m%d-%H%M%S)"
    echo "Backfill batch $batch — scanning recording directories..."
    total=0; new=0
    # Newest first, so recent history is useful within minutes.
    find "${ANCHOR_CALL_DIRS:-/storage/emulated/0/Recordings/Call /storage/emulated/0/Call /storage/emulated/0/Sounds/Voicemail}" \
        -type f \( -iname '*.m4a' -o -iname '*.mp3' -o -iname '*.amr' -o -iname '*.3gp' -o -iname '*.wav' -o -iname '*.aac' -o -iname '*.ogg' \) \
        -printf '%T@ %p\n' 2>/dev/null | sort -rn | cut -d' ' -f2- | while read -r f; do
        total=$((total+1))
        kind=call; case "$f" in *oicemail*|*VVM*) kind=voicemail;; esac
        resp=$(upload_file "$f" "$kind" "$batch" true)
        dup=$(echo "$resp" | jq -r '.duplicate // "error"')
        case "$dup" in
            false) new=$((new+1)); echo "[$total] uploaded: $(basename "$f")";;
            true)  echo "[$total] already ingested: $(basename "$f")";;
            *)     echo "[$total] FAILED: $(basename "$f") — $resp";;
        esac
        echo "$total $new" > "$STATE_DIR/backfill.progress"
    done
    echo "Upload pass done. Server is transcribing + processing."
    echo "Report: anchor backfill-report $batch   (re-run any time)"
    echo "$batch" > "$STATE_DIR/last_backfill_batch"
    ;;
backfill-report)
    batch="${2:-$(cat "$STATE_DIR/last_backfill_batch" 2>/dev/null)}"
    [ -z "$batch" ] && { echo "usage: anchor backfill-report <batch_id>"; exit 1; }
    api GET "/v1/backfill/report?batch_id=$batch" | jq -r '
        "Backfill \(.batch_id): \(.count) files, \(.transcribed) transcribed, \(.processed) processed, \(.still_processing) still processing",
        "", "UPCOMING APPOINTMENTS FOUND:",
        (.upcoming_appointments[]? | "  • \(.title) — \(.start)"),
        "", "OPEN RETURN-CALLS:",
        (.open_return_calls[]? | "  • \(.title) \(.phone_number // "")"),
        "", "NEEDS CONFIRM:",
        (.needs_confirm[]? | "  • \(.summary)")'
    ;;
log)
    shift; text="${*:-}"
    [ -z "$text" ] && { printf "symptom> "; read -r text; }
    api POST /v1/symptoms -H 'Content-Type: application/json' \
        -d "$(jq -n --arg t "$text" '{text: $t}')" >/dev/null \
        && notify_user "Symptom logged." || notify_user "Symptom log FAILED — try again."
    ;;
report)
    days="${2:-90}"
    out="/storage/emulated/0/Download/anchor-symptom-report.pdf"
    if api GET "/v1/symptoms/report.pdf?days=$days" -o "$out"; then
        notify_user "Report saved to Downloads (last $days days)."
        command -v termux-open >/dev/null && termux-open "$out"
    else
        echo "Report download failed."
    fi
    ;;
sweep)
    exec "$HOME/.anchor/bin/anchor-sweep"
    ;;
status)
    api GET /v1/health | jq '{queue, dry_run, heartbeats: (.heartbeats | map_values(.last_seen))}'
    ;;
*)
    cat <<'EOF'
anchor — your external memory. Commands:
  anchor rec / anchor stop    record a voice note, auto-upload
  anchor photo                snap a photo into the timeline
  anchor note [text]          save a text note
  anchor ask <question>       ask the record (answers cite sources)
  anchor fix <correction>     fix a wrong event/task/fact
  anchor log [text]           log a symptom (dated)
  anchor report [days]        symptom-log PDF for the doctor (default 90)
  anchor backfill             upload ALL existing call recordings/voicemails
  anchor backfill-report      what backfill found
  anchor sweep                force a sync sweep now
  anchor status               server health
EOF
    ;;
esac
