[Unit]
Description=Anchor worker (queue drain: transcribe + agent turns)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anchor
Group=anchor
EnvironmentFile=/etc/anchor/anchor.env
ExecStart=/opt/anchor/venv/bin/anchor-worker
Restart=always
RestartSec=5
# Give whisper time to finish the current segment on stop; the durable queue
# makes a hard kill safe anyway.
TimeoutStopSec=30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/anchor
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
