<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Voice messages: record audio to send in chat. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Location: the grid, the distance figures and the map picker all need a
         position. These also arrive by AAR manifest merging from
         tauri-plugin-geolocation, but they are declared here so the app's full
         permission set is auditable in this one file and cannot change silently
         when a plugin is bumped. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- NOT declared, deliberately (removed v0.1.33):
         READ_MEDIA_IMAGES / READ_MEDIA_VIDEO / READ_EXTERNAL_STORAGE
           There is no local photo library. Every photo the app touches comes from
           the Grindr API, and any local selection goes through <input type="file">
           -> the system document picker, which needs no storage permission. These
           three were left over from a removed feature and only widened the store
           listing's permission list.

         FOREGROUND_SERVICE / FOREGROUND_SERVICE_DATA_SYNC
           The dataSync keep-alive service that needed these was removed with
           org.opengrind.NotificationService, which was the source of the
           ForegroundServiceDidNotStopInTimeException crash and which the
           FCM path replaces. Declaring them now would request a capability
           nothing uses. Reintroduce only alongside a real service. -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.open_grind"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <!--
                No LAUNCHER filter here on purpose. MainActivity is the TARGET of
                both aliases below, and a launcher filter on the target as well
                as on an alias is how you end up with two icons on the home
                screen and a "always"/"just once" prompt — which would make the
                discreet toggle half-work instead of switching.
            -->
        </activity>

        <!--
            Discreet app icon — restored 2026-10-11.

            Both aliases had been dropped from the manifest while
            DiscreetIconSetting.svelte was left in place. That component gates
            itself on `{#if available}`, where `available` requires the
            `__DiscreetMode` bridge, which was gone too — so the toggle silently
            never rendered and the feature was unreachable with nothing to say
            so. The weather icon assets and the `weather_app_name` string were
            still present, so this was a half-finished removal, not a decision.

            MainActivity must NOT itself carry the LAUNCHER filter alongside
            these: two launcher entries for one activity is what makes the
            disambiguation prompt appear, and the discreet toggle stops being a
            single predictable switch. The filter is therefore on MainAlias only.
        -->
        <activity-alias
            android:name=".MainAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/main_activity_title"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Discreet mode: weather alias — disabled by default, enabled via settings -->
        <activity-alias
            android:name=".WeatherAlias"
            android:targetActivity=".MainActivity"
            android:label="@string/weather_app_name"
            android:icon="@mipmap/ic_launcher_weather"
            android:enabled="false"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
