<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup/transfer rules.

  `allowBackup="false"` already disables `adb backup` and cloud backup, but
  device-to-device transfer is controlled separately by these rules, so both are
  excluded explicitly. Without this the app's data directory could be extracted
  with `adb backup` or moved to a new device, and it contains:
    - preferences.data (msgpack) - contains the user's geohash, i.e. their
      location at roughly +/-4 m, plus every grid filter
    - WebView localStorage - the app-lock salt and PIN hash
    - grindrx-mediaid-cache     - signed CloudFront URLs
  None of that should leave the device the user installed it on.

  Each <exclude> deliberately omits path=. AOSP resolves a missing path
  to the domain directory itself (FullBackup.extractCanonicalFile maps
  null -> "" and returns new File(domainDir, "")), and
  BackupUtils.isFileSpecifiedInPathList then excludes anything whose
  canonical path startsWith that directory. So <exclude domain="root" />
  alone already covers files/, cache/ and no_backup/, and omitting path
  avoids the .. and // sequences the parser rejects.

  Valid domains are the nine below (FullBackup
  .getDirectoryForCriteriaDomain); an unrecognised domain is silently
  skipped, so all nine are listed.
-->
<data-extraction-rules>
	<cloud-backup>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
		<exclude domain="external" />
		<!-- Device-protected storage (/data/user_de). Nothing in the app writes
		     here today: neither the app nor any dependency calls
		     createDeviceProtectedStorageContext(), and the manifest does not
		     set android:defaultToDeviceProtectedStorage, so this is
		     defence in depth. Without these four, device-protected storage
		     would still be transferred on a future feature that does use
		     it, and nothing in the build would flag that. -->
		<exclude domain="device_root" />
		<exclude domain="device_file" />
		<exclude domain="device_database" />
		<exclude domain="device_sharedpref" />
	</cloud-backup>
	<device-transfer>
		<exclude domain="root" />
		<exclude domain="file" />
		<exclude domain="database" />
		<exclude domain="sharedpref" />
		<exclude domain="external" />
		<!-- Device-protected storage (/data/user_de). Nothing in the app writes
		     here today: neither the app nor any dependency calls
		     createDeviceProtectedStorageContext(), and the manifest does not
		     set android:defaultToDeviceProtectedStorage, so this is
		     defence in depth. Without these four, device-protected storage
		     would still be transferred on a future feature that does use
		     it, and nothing in the build would flag that. -->
		<exclude domain="device_root" />
		<exclude domain="device_file" />
		<exclude domain="device_database" />
		<exclude domain="device_sharedpref" />
	</device-transfer>
</data-extraction-rules>
