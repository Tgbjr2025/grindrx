{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "default",
	"description": "Shared capability for all platforms. Deliberately narrow: the app only WRITES to the clipboard (invite links, copied message text) so clipboard read access is not granted, and opener is limited to open-url because the OS file/path openers are never used.",
	"windows": [
		"main"
	],
	"permissions": [
		"core:default",
		"os:default",
		{
			"identifier": "fs:allow-app-read",
			"allow": [
				{
					"path": "$APPDATA/preferences.json"
				},
				{
					"path": "$APPDATA/preferences.data"
				}
			]
		},
		{
			"identifier": "fs:allow-app-write",
			"allow": [
				{
					"path": "$APPDATA/preferences.json"
				},
				{
					"path": "$APPDATA/preferences.data"
				},
				{
					"path": "$APPDATA/preferences.data.tmp"
				}
			]
		},
		{
			"identifier": "fs:allow-exists",
			"allow": [
				{
					"path": "$APPDATA/preferences.json"
				},
				{
					"path": "$APPDATA/preferences.data"
				}
			]
		},
		{
			"identifier": "fs:allow-rename",
			"allow": [
				{
					"path": "$APPDATA/preferences.data.tmp"
				},
				{
					"path": "$APPDATA/preferences.data"
				}
			]
		},
		"clipboard-manager:allow-write-text",
		"opener:allow-open-url"
	]
}
