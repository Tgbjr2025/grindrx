# Copy to .env and fill in. NEVER commit the real .env file.

# --- Claude (decision engine) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- MetaApi bridge to your trading.com MT5 account ---
# 1. Open an MT5 account at trading.com (start with a DEMO account).
# 2. Sign up at https://metaapi.cloud, add the MT5 account (server + login + investor/main password).
# 3. Paste the MetaApi token and the account id it assigns here.
METAAPI_TOKEN=
METAAPI_ACCOUNT_ID=

# --- Optional extras ---
# Webhook (Discord/Slack-compatible) for trade + kill-switch notifications
NOTIFY_WEBHOOK_URL=
